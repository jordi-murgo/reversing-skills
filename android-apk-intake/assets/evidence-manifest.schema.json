{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jordi-murgo/reversing-skills/schemas/apk-evidence-manifest-v1.json",
  "title": "APK evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "authorization_ref", "label", "source", "tools", "summary", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "authorization_ref": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["apk", "archive", "directory", "installed-package"]},
        "device": {"type": ["string", "null"]}
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aapt2", "apksigner"],
      "properties": {
        "aapt2": {"type": ["string", "null"]},
        "apksigner": {"type": ["string", "null"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apk_count", "package_names", "verified_signer_set_count", "signer_consistent", "set_consistency"],
      "properties": {
        "apk_count": {"type": "integer", "minimum": 1},
        "package_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "verified_signer_set_count": {"type": "integer", "minimum": 0},
        "signer_consistent": {"type": ["boolean", "null"]},
        "set_consistency": {"enum": ["consistent", "inconsistent", "unknown"]}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "original_name", "sha256", "bytes", "archive", "signing", "package"],
        "properties": {
          "file": {"type": "string", "pattern": "^artifacts/"},
          "original_name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "archive": {"type": "object"},
          "signing": {"type": "object"},
          "package": {"type": "object"}
        }
      }
    }
  }
}
